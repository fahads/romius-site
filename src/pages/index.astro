---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>RoMIUS — Development Preview</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <main class="mx-auto max-w-3xl px-6 py-24">
      <p class="text-sm font-semibold uppercase tracking-widest text-teal-700">
        RoMIUS Institute
      </p>
      <h1 class="mt-4 text-4xl font-bold sm:text-6xl">
        Website development preview
      </h1>
      <p class="mt-6 text-lg text-slate-600">
        The Astro and Tailwind foundation is ready.
        This is a development environment, not the live practice website.
      </p>
    </main>
  </body>
</html>
